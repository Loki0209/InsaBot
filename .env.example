# ===============================================
# Automated AI News Reel Bot - Environment Variables
# ===============================================

# NewsAPI Credentials (REQUIRED)
# Get from: https://newsapi.org/register
# Free tier: 100 requests/day
NEWSAPI_KEY=your_newsapi_key_here

# Google Gemini API (REQUIRED)
# Get from: https://aistudio.google.com/app/apikey
# Free tier: ~15 requests/minute, unlimited daily
GEMINI_API_KEY=your_gemini_api_key_here

# EdgeTTS Voice (OPTIONAL - uses Microsoft Edge TTS)
# Completely FREE with no API key needed! Unlimited usage!
# Default voice: en-US-AriaNeural (Female, American)
# Popular voices:
# - en-US-AriaNeural (Female, Natural)
# - en-US-GuyNeural (Male, Natural)
# - en-US-JennyNeural (Female, Assistant-style)
# - en-US-EricNeural (Male, News-style)
# - en-GB-SoniaNeural (Female, British)
# - en-GB-RyanNeural (Male, British)
# - en-AU-NatashaNeural (Female, Australian)
# - en-IN-NeerjaNeural (Female, Indian)
# To list all voices: edge-tts --list-voices
EDGE_TTS_VOICE=en-US-AriaNeural

# Pexels API (OPTIONAL - for real stock photos)
# Get from: https://www.pexels.com/api/
# If not set, gradient placeholders will be used
# Free tier: Unlimited requests
PEXELS_API_KEY=IBMPRj9spXNJhW4ZwMTodb4bHJ6b0jeHn2hT0oFYvL8bIz6yd1DrxN77

# ===============================================
# Configuration Settings
# ===============================================

# News category to fetch
# Options: business, entertainment, general, health, science, sports, technology
NEWS_CATEGORY=technology

# Number of articles to fetch (bot uses first one)
POST_LIMIT=5

# Video output dimensions (9:16 vertical for Instagram/TikTok)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
